generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  username          String    @unique
  name              String
  email             String    @unique
  phone             String?
  phoneVerifiedAt   DateTime? // set when phone OTP verified
  passwordHash      String?
  googleId          String?   @unique
  image             String?
  platformRole      String    @default("USER") // Enum PlatformRole
  status            String    @default("ACTIVE") // ACTIVE, PENDING_VERIFICATION, BANNED, SOFT_DELETED
  deletedAt         DateTime?
  activeClinicId    String?
  onboardingStep    String    @default("CLINIC_DETAILS")
  notificationPrefs String? // JSON string
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  memberships Membership[]
}

enum TaxCalculationMode {
  NONE                     // no tax added, amount charged as-is
  FLAT_PERCENTAGE          // a single flat % added on top, shown as one line (e.g. VAT)
  SPLIT_BY_SUPPLY_REGION   // India-style: compare the clinic's region to our own registered
                            // region to decide CGST+SGST (same-region) vs IGST (cross-region)
}

model TaxCountryConfig {
  id                  String              @id @default(cuid())
  countryCode         String              @unique   // ISO 3166-1 alpha-2, e.g. "IN", "US", "GB", "AE"
  countryName         String                        // "India", "United States", ...
  currencyBucket      String                        // "INR" | "USD" — which existing pricing bucket this country maps to
  taxLabel            String                        // "GST" | "VAT" | "Sales Tax" | "No Tax"
  taxIdLabel          String?                       // "GSTIN" | "VAT Number" | null if not applicable
  calculationMode     TaxCalculationMode  @default(NONE)
  flatRate            Float?                        // overall %, e.g. 18 for India GST, 20 for UK VAT
  ourRegisteredRegion String?                        // OUR state/region — only used for SPLIT_BY_SUPPLY_REGION
  invoiceNumberPrefix String?                        // e.g. "OO-IN", "OO-US"
  isActive            Boolean             @default(true)  // offered as a choice at onboarding
  sortOrder           Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}


model Clinic {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  type          String
  phone         String?
  whatsappNumber String?
  address       String?
  openTime      String?   @default("09:00")
  closeTime     String?   @default("18:00")
storageRoot              String?  @unique
  storageUsedBytes         Int      @default(0)
  pricingMarketLocked      Boolean  @default(false)
  geoMismatchFlag          Boolean  @default(false)
  detectedCountryAtSignup  String?
    status        String    @default("ACTIVE") // Enum ClinicStatus
  countryCode   String?   // FK-equivalent to TaxCountryConfig.countryCode, set at onboarding
  region        String?   // state/province — required when the selected country uses SPLIT_BY_SUPPLY_REGION, optional otherwise
  taxId         String?   // the clinic's own tax ID (their GSTIN/VAT number) if they have one — B2B invoicing
  billingConfig String? // JSON string for region-specific compliance
  createdAt     DateTime  @default(now())
  lockedAt      DateTime? // Tracks when clinic was locked (e.g. cancelled sub)

  memberships          Membership[]
  patients             Patient[]
  doctors              Doctor[]
  appointments         Appointment[]
  invoices             Invoice[]
  records              MedicalRecord[]
  subscription         Subscription?
  bookingRequests      BookingRequest[]
  promoRedemptions     PromoRedemption[]
  payments             Payment[]
  clinicPlugins        ClinicPlugin[]
  inventoryItems       InventoryItem[]
  prescriptions        Prescription[]
  storageUsages        StorageUsage[]
  bookingPageConfig    BookingPageConfig?
  PatientDocument      PatientDocument[]
  patientAccountLinks  PatientAccountLink[]
  patientNotifications PatientNotification[]
  dataExportRequests   DataExportRequest[]

  shareRecordsWithPatients Boolean @default(false)

  baaRequests BaaRequest[]
  taxInvoices TaxInvoice[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  clinicId  String
  role      String // Enum ClinicRole (OWNER, ADMIN, DOCTOR, FRONT_DESK)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId])
}

model Plan {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique
  description           String?
  priceMonthlyUsd       Int      @default(0)
  priceYearlyUsd        Int?
  priceMonthlyInr       Int      @default(0)
  priceYearlyInr        Int?
  patientLimit          Int?
  doctorLimit           Int?
  storageLimitGb        Int?
  bookingPageLimit      Int? // null = unlimited booking entries per month
  features              String // JSON array of extra marketing bullets (extraBullets)
  isFeatured            Boolean  @default(false)
  isActive              Boolean  @default(true)
  sortOrder             Int      @default(0)
  isDefaultFree         Boolean  @default(false)
  razorpayPlanIdMonthly String?
  razorpayPlanIdYearly  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  subscriptions Subscription[]
  promos        Promo[]
  planFeatures  PlanFeature[]
}

model Subscription {
  id                     String    @id @default(cuid())
  clinicId               String    @unique
  planId                 String
  status                 String    @default("TRIALING") // Enum SubscriptionStatus
  billingCycle           String    @default("monthly")
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  promoId                String?
  promoExpiresAt         DateTime?
  razorpayCustomerId     String?
  razorpaySubscriptionId String?
  cancelAtPeriodEnd      Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])
}

enum BaaRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model BaaRequest {
  id                String           @id @default(cuid())
  clinicId          String
  requestedByUserId String
  status            BaaRequestStatus @default(PENDING)

  clinicLegalName String
  ownerFullName   String
  ownerTitle      String @default("Clinic Owner")

  bizRegCertKey      String?
  signatoryAuthKey   String?
  photoIdKey         String?
  addressProofKey    String?
  practiceLicenseKey String?

  requestedAt       DateTime  @default(now())
  reviewedByAdminId String?
  approvedAt        DateTime?
  rejectedReason    String?

  documentReferenceNumber String? @unique
  legalTextSnapshot       String?
  templateVersionLabel    String?
  pdfFileKey              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

model BaaTemplateVersion {
  id                 String   @id @default(cuid())
  bodyText           String
  versionLabel       String   @unique
  isCurrent          Boolean  @default(false)
  publishedAt        DateTime @default(now())
  publishedByAdminId String
}

model Patient {
  id         String   @id @default(cuid())
  clinicId   String
  displayId  String
  name       String
  age        Int
  gender     String
  phone      String
  email      String?
  address    String?
  bloodGroup String?
  allergies  String?
  condition  String?
  colorTag   String   @default("#1E4638")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  clinic             Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments       Appointment[]
  invoices           Invoice[]
  records            MedicalRecord[]
  prescriptions      Prescription[]
  PatientDocument    PatientDocument[]
  patientAccountLink PatientAccountLink?

  @@unique([clinicId, displayId])
}

model Doctor {
  id          String   @id @default(cuid())
  clinicId    String
  userId      String?
  name        String
  specialty   String
  phone       String
  email       String
  workingDays String // Was String[], store as JSON string or comma-separated
  createdAt   DateTime @default(now())

  clinic        Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  records       MedicalRecord[]
  prescriptions Prescription[]
}

model Appointment {
  id        String   @id @default(cuid())
  clinicId  String
  patientId String
  doctorId  String
  date      DateTime // Removed @db.Date
  time      String
  duration  Int      @default(30)
  reason    String
  status    String   @default("SCHEDULED") // Enum AppointmentStatus
  visitType String   @default("IN_PERSON") // "IN_PERSON" | "VIDEO"
  roomId    String?
  // Patient join-link token (unguessable, scoped to this appointment only)
  patientLinkToken       String?   @unique
  patientLinkTokenExpiry DateTime?
  createdAt DateTime @default(now())

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  videoAccessLogs VideoCallAccessLog[]
}

model Invoice {
  id             String   @id @default(cuid())
  clinicId       String
  patientId      String
  displayId      String
  date           DateTime
  status         String   @default("UNPAID")
  items          String   // JSON string of line items
  prescriptionId String?  // Optional: linked prescription for combined invoice+Rx print
  createdAt      DateTime @default(now())

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescription Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)

  @@unique([clinicId, displayId])
}

model MedicalRecord {
  id           String   @id @default(cuid())
  clinicId     String
  patientId    String
  doctorId     String
  date         DateTime // Removed @db.Date
  diagnosis    String
  prescription String?
  notes        String?
  documentUrl  String?
  createdAt    DateTime @default(now())

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model PatientDocument {
  id        String   @id @default(cuid())
  clinicId  String
  patientId String
  recordId  String?
  name      String
  type      String // "LAB_REPORT", "XRAY", "PRESCRIPTION", "OTHER"
  url       String
  sizeBytes Int
  createdAt DateTime @default(now())

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([patientId])
}

model BookingRequest {
  id        String   @id @default(cuid())
  clinicId  String
  name      String
  email     String
  phone     String
  doctorId  String?
  date      String
  time      String
  reason    String
  notes     String?
  status    String   @default("PENDING") // PENDING | CONFIRMED | REJECTED
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

model Promo {
  id              String    @id @default(cuid())
  name            String // internal label
  targetPlanId    String // which Plan gets unlocked
  durationDays    Int // how many days of free access
  eligibility     String    @default("NEW_CLINICS_ONLY") // NEW_CLINICS_ONLY | ALL_CLINICS
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean   @default(true)
  redemptionLimit Int? // null = unlimited
  redemptionCount Int       @default(0)
  headline        String // customer-facing
  subtext         String? // customer-facing
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  targetPlan  Plan              @relation(fields: [targetPlanId], references: [id])
  redemptions PromoRedemption[]
}

model PromoRedemption {
  id         String   @id @default(cuid())
  promoId    String
  clinicId   String
  redeemedAt DateTime @default(now())
  expiresAt  DateTime

  promo  Promo  @relation(fields: [promoId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([promoId, clinicId])
}

model Payment {
  id                String   @id @default(cuid())
  clinicId          String
  amount            Int
  currency          String
  status            String // "succeeded" | "failed" | "refunded"
  razorpayPaymentId String?
  createdAt         DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

model AuditLogEntry {
  id          String   @id @default(cuid())
  actorUserId String // which Super Admin did it
  action      String // "SUSPEND_CLINIC" | "CHANGE_PLAN" | "GRANT_PROMO" | ...
  targetType  String // "Clinic" | "User" | "Plan" | "Promo"
  targetId    String
  metadata    String? // JSON string
  createdAt   DateTime @default(now())
}

model PlatformFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String
  category    String // "Access" | "Billing" | "Modules" | "Platform"
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model Feature {
  id                String   @id @default(cuid())
  key               String   @unique // "appointments.calendar", "billing.invoices"
  name              String // "Appointment calendar"
  description       String?
  category          String // "Core" | "Scheduling" | "Billing" | "Communication" | "Support"
  isGloballyEnabled Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  planFeatures PlanFeature[]
}

model PlanFeature {
  id        String  @id @default(cuid())
  planId    String
  featureId String
  included  Boolean @default(true)

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ─── Plugin Marketplace ──────────────────────────────────────────────────────

model Plugin {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  tagline     String
  description String
  category    String // "Clinical" | "Operations"
  icon        String // lucide-react icon name
  kind        String @default("FEATURE_UNLOCK") // "FEATURE_UNLOCK" | "LIMIT_MODIFIER"

  priceOneTimeINR Int?
  priceOneTimeUSD Int?
  priceMonthlyINR Int?
  priceMonthlyUSD Int?
  priceYearlyINR  Int?
  priceYearlyUSD  Int?

  isActive     Boolean @default(true)
  isComingSoon Boolean @default(false)
  sortOrder    Int     @default(0)

  razorpayPlanIdMonthly String?
  razorpayPlanIdYearly  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinicPlugins ClinicPlugin[]
}

model ClinicPlugin {
  id           String  @id @default(cuid())
  clinicId     String
  pluginId     String
  pricingModel String // "ONE_TIME" | "MONTHLY" | "YEARLY"
  status       String  @default("ACTIVE") // "ACTIVE" | "EXPIRED" | "CANCELED"
  isEnabled    Boolean @default(true)
  quantity     Int     @default(1) // For LIMIT_MODIFIER plugins (e.g., 3 extra doctor seats)

  purchasedAt       DateTime  @default(now())
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)

  razorpaySubscriptionId String?
  razorpayOrderId        String?

  grantedByAdmin Boolean @default(false)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  plugin Plugin @relation(fields: [pluginId], references: [id])

  @@unique([clinicId, pluginId])
}

// ─── Storage Usage Tracking ───────────────────────────────────────────────────

model StorageUsage {
  id        String   @id @default(cuid())
  clinicId  String
  filePath  String // relative path under public/uploads
  bytes     Int // file size in bytes
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
}

// ─── Inventory Management Plugin ─────────────────────────────────────────────

model InventoryItem {
  id               String   @id @default(cuid())
  clinicId         String
  name             String
  sku              String?
  unit             String
  quantityOnHand   Int      @default(0)
  reorderThreshold Int      @default(5)
  unitCost         Int?
  createdAt        DateTime @default(now())

  clinic       Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]
}

model InventoryTransaction {
  id        String   @id @default(cuid())
  itemId    String
  change    Int
  reason    String // "RESTOCK" | "USED_IN_VISIT" | "ADJUSTMENT"
  recordId  String?
  createdAt DateTime @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

// ─── E-Prescriptions Plugin ───────────────────────────────────────────────────

model Prescription {
  id        String   @id @default(cuid())
  clinicId  String
  patientId String
  recordId  String?
  doctorId  String
  date      DateTime
  items     String // JSON: [{ drug, dosage, frequency, durationDays, notes }]
  createdAt DateTime @default(now())

  clinic   Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor   Doctor   @relation(fields: [doctorId], references: [id])
  invoices Invoice[]
}

// ─── Global Settings & Auth ───────────────────────────────────────────────────

model GlobalSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model OtpToken {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ─── Marketing / CRM ──────────────────────────────────────────────────────────

model ContactLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  reason    String   @default("General inquiry") // e.g. "General inquiry" | "Technical support" | "Billing" | "Feature request"
  source    String   @default("CONTACT_FORM")  // "CONTACT_FORM" | "IN_APP_FEEDBACK"
  metadata  String?  // JSON — page URL, browser info, clinicId captured by feedback widget
  status    String   @default("NEW") // "NEW", "CONTACTED", "ARCHIVED"
  createdAt DateTime @default(now())
}

model DemoRequest {
  id              String  @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  jobTitle        String?
  country         String?
  phone           String?
  companyName     String?
  employees       String?
  message         String?
  newsletterOptIn Boolean @default(false)

  // Temp Credential Tracking
  status     String    @default("PENDING") // PENDING, CREDENTIALS_GENERATED, USED, EXPIRED
  tempUserId String? // ID of the temporary user generated
  token      String?   @unique
  expiresAt  DateTime?

  createdAt DateTime @default(now())
}

// ─── Branded Booking Page Plugin ──────────────────────────────────────────────

model BookingPageConfig {
  id       String @id @default(cuid())
  clinicId String @unique

  // Visual Branding
  logoUrl     String?
  faviconUrl  String?
  coverUrl    String?
  accentColor String  @default("#1E4638") // hex; defaults to forest green

  // Content
  displayName String? // can differ from clinic.name
  tagline     String?
  aboutText   String?
  showAddress Boolean @default(true)
  showPhone   Boolean @default(true)
  showHours   Boolean @default(true)

  // Booking behaviour (JSON arrays stored as strings)
  bookableDoctorIds String? // JSON: string[] of Doctor.id values enabled for public booking
searchIndexing Boolean @default(false)
    appointmentTypes  String? // JSON: string[] — editable dropdown options for "Reason for visit"

  // Footer
  showPoweredBy Boolean @default(true) // only honoured server-side when plugin IS active; forced true when not
  socialLinks   String? // JSON: { website?, instagram?, facebook?, twitter? }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

model AccountDeletionRequest {
  id        String   @id @default(cuid())
  email     String
  reason    String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// WhatsApp / Communications Integration
// ═══════════════════════════════════════════════════════════════

/// Singleton table — one row, always upserted on write.
model PlatformCommunicationSettings {
  id String @id @default(cuid())

  whatsappNumber             String? // e.g. "+919800000000"
  whatsappPhoneNumberId      String? // Meta Cloud API Phone Number ID
  whatsappBusinessAccountId  String? // Meta WABA ID
  whatsappAccessToken        String? // AES-256-GCM encrypted at rest — never stored plain
  whatsappWebhookVerifyToken String? // used to validate Meta webhook calls
  whatsappConnected          Boolean   @default(false)
  whatsappLastVerifiedAt     DateTime?
  whatsappLastError          String? // last test-connection error message

  // Legacy OTP fields — kept for backward compat, superseded by otpChannels/otpMode below
  otpChannel  String  @default("EMAIL") // "EMAIL" | "WHATSAPP" | "BOTH" — DEPRECATED, use otpChannels
  otpBothMode String? // "USER_CHOOSES" | "SEND_BOTH" — DEPRECATED, use otpMode

  // ── SMS — India (MSG91 / Kaleyra) ──────────────────────────────────────────
  smsProviderIndia             String? // "MSG91" | "KALEYRA"
  smsApiKeyIndia               String? // AES-256-GCM encrypted at rest — same key as whatsappAccessToken
  smsSenderIdIndia             String? // DLT-registered sender ID (typically 6 characters)
  smsDltTemplateIdOtp          String? // DLT-approved template ID for OTP messages — REQUIRED for India sends
  smsDltTemplateIdConfirmation String? // DLT-approved template ID for appointment confirmations — REQUIRED for India sends
  smsConnectedIndia            Boolean @default(false)

  // ── SMS — International (Twilio) ───────────────────────────────────────────
  smsProviderInternational   String? // "TWILIO"
  smsAccountSidInternational String? // Twilio Account SID
  smsAuthTokenInternational  String? // AES-256-GCM encrypted at rest — same key as whatsappAccessToken
  smsFromNumberInternational String?
  smsConnectedInternational  Boolean @default(false)

  smsLastVerifiedAt DateTime?

  // ── OTP channel multi-select (replaces otpChannel + otpBothMode) ────────────
  otpChannels String[] @default(["EMAIL"]) // any combination of "EMAIL" | "WHATSAPP" | "SMS"
  otpMode     String   @default("USER_CHOOSES") // "USER_CHOOSES" | "SEND_ALL" — only relevant when otpChannels.length > 1

  // ── Appointment confirmation fallback ───────────────────────────────────────
  appointmentConfirmationFallbackChannel String @default("EMAIL") // "EMAIL" | "SMS" — used ONLY when clinic does NOT have WhatsApp Reminders add-on

  updatedAt DateTime @updatedAt
}

/// Maps internal event types to Meta-approved template names.
/// Seeded with 5 inactive/empty rows — admin fills in real names after Meta approval.
model WhatsAppTemplateMapping {
  id               String  @id @default(cuid())
  eventType        String  @unique // "OTP_VERIFICATION" | "APPOINTMENT_CONFIRMATION" | "APPOINTMENT_REMINDER" | "APPOINTMENT_CANCELLED" | "GENERAL_UPDATE"
  metaTemplateName String  @default("") // exact name as approved in Meta Business Manager
  variablesSchema  String  @default("[]") // JSON: documents expected variable order/names
  isActive         Boolean @default(false) // inactive until admin fills in a real template name
}

/// Audit trail for every WhatsApp message sent through the platform.
model WhatsAppMessageLog {
  id            String   @id @default(cuid())
  clinicId      String? // null for platform-level OTP sends not tied to a clinic
  patientId     String?
  appointmentId String?
  userId        String? // set for OTP sends tied to a registering User
  toPhone       String
  eventType     String // "OTP_VERIFICATION" | "APPOINTMENT_CONFIRMATION" | etc.
  status        String // "SENT" | "DELIVERED" | "READ" | "FAILED"
  metaMessageId String?
  errorMessage  String?
  sentAt        DateTime @default(now())

  @@index([clinicId])
  @@index([sentAt])
}

/// Tracks the most-recent outbound context per (phone, clinic) pair.
/// Used to route inbound replies to the correct clinic's inbox when two-way messaging is added.
model WhatsAppConversationContext {
  id            String   @id @default(cuid())
  phone         String
  clinicId      String
  patientId     String?
  lastMessageAt DateTime @default(now())

  @@unique([phone, clinicId])
  @@index([phone])
}

/// Audit trail for every SMS sent — OTP_VERIFICATION and APPOINTMENT_CONFIRMATION only.
/// Per CHARTWELL_SMS_INTEGRATION_SPEC.md Section 6: SMS is structurally restricted to these two event types.
model SmsMessageLog {
  id                String   @id @default(cuid())
  clinicId          String? // null for OTP sends not tied to a clinic
  patientId         String?
  appointmentId     String?
  userId            String? // set for OTP sends tied to a registering User
  toPhone           String
  eventType         String // "OTP_VERIFICATION" | "APPOINTMENT_CONFIRMATION" — nothing else is valid
  provider          String // "MSG91" | "KALEYRA" | "TWILIO"
  status            String // "SENT" | "DELIVERED" | "FAILED"
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime @default(now())

  @@index([clinicId])
  @@index([sentAt])
  @@index([eventType])
}

// ─── Patient Portal Account System ────────────────────────────────────────────

/// One per real person — keyed by email, optionally phone.
/// passwordHash is null until first-time password setup is completed.
model PatientAccount {
  id              String    @id @default(cuid())
  email           String    @unique
  phone           String?
  passwordHash    String?
  name            String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  links              PatientAccountLink[]
  notifications      PatientNotification[]
  loginCodes         PatientLoginCode[]
  dataExportRequests DataExportRequest[]
}

/// Join table linking a PatientAccount to a specific clinic's Patient record.
/// Mirrors the Membership pattern for staff.
model PatientAccountLink {
  id               String   @id @default(cuid())
  patientAccountId String
  clinicId         String
  patientId        String   @unique // FK to clinic-scoped Patient — unique ensures 1:1 per clinic
  linkedAt         DateTime @default(now())

  patientAccount PatientAccount @relation(fields: [patientAccountId], references: [id], onDelete: Cascade)
  clinic         Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientAccountId, clinicId])
}

/// Stores hashed login codes for passwordless/forgot-password flow.
/// Never store raw codes.
model PatientLoginCode {
  id               String    @id @default(cuid())
  patientAccountId String
  codeHash         String
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())

  patientAccount PatientAccount @relation(fields: [patientAccountId], references: [id], onDelete: Cascade)

  @@index([patientAccountId])
}

/// In-app notification feed for patients — written on every trigger event.
model PatientNotification {
  id               String    @id @default(cuid())
  patientAccountId String
  clinicId         String
  type             String // "APPOINTMENT_CONFIRMED" | "APPOINTMENT_UPDATED" | "INVOICE_CREATED" | "INVOICE_PAID" | "PRESCRIPTION_ISSUED" | "RECORD_SHARED"
  title            String
  body             String
  relatedId        String?
  readAt           DateTime?
  createdAt        DateTime  @default(now())

  patientAccount PatientAccount @relation(fields: [patientAccountId], references: [id], onDelete: Cascade)
  clinic         Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([patientAccountId, clinicId])
  @@index([createdAt])
}

/// Request by a patient to export all their data from a clinic
model DataExportRequest {
  id               String    @id @default(cuid())
  patientAccountId String
  clinicId         String
  status           String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, REJECTED
  downloadUrl      String?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  patientAccount PatientAccount @relation(fields: [patientAccountId], references: [id], onDelete: Cascade)
  clinic         Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([patientAccountId])
}

/// Access-only audit log for video consultations.
/// Stores only WHO joined/left WHEN — no recordings, chat, or call content.
model VideoCallAccessLog {
  id            String   @id @default(cuid())
  clinicId      String
  appointmentId String
  roomId        String
  role          String   // "doctor" | "patient"
  identifier    String   // doctorId or patientId (name/id)
  event         String   // "JOINED" | "ADMITTED" | "LEFT" | "LINK_REVOKED" | "ENDED" | "DENIED"
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([appointmentId])
}

// ─── Email Notification System ────────────────────────────────────────────────

/// Audit trail for every email sent (or skipped) through sendNotificationEmail().
/// recipientType: "STAFF" | "PATIENT" | "ADMIN" | "LEAD"
/// status:        "SENT" | "FAILED" | "BOUNCED" | "SKIPPED"
model EmailLog {
  id                String   @id @default(cuid())
  recipientType     String             // "STAFF" | "PATIENT" | "ADMIN" | "LEAD"
  recipientId       String?            // userId / patientAccountId / null for pre-account leads
  clinicId          String?            // null for platform-level emails not tied to a clinic
  eventType         String             // a key from EMAIL_EVENTS catalog
  toEmail           String
  subject           String
  status            String             // "SENT" | "FAILED" | "BOUNCED" | "SKIPPED"
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime @default(now())

  @@index([recipientId])
  @@index([clinicId])
  @@index([eventType])
  @@index([sentAt])
}

/// Per-user or per-patient toggle for TOGGLEABLE notification events.
/// Mandatory events (per catalog) never appear here — they send unconditionally.
/// ownerType: "USER" | "PATIENT_ACCOUNT"
model NotificationPreference {
  id        String  @id @default(cuid())
  ownerType String            // "USER" | "PATIENT_ACCOUNT"
  ownerId   String
  eventType String            // must be a TOGGLEABLE event per catalog — never a mandatory one
  enabled   Boolean @default(true)

  @@unique([ownerType, ownerId, eventType])
  @@index([ownerId])
}

// ─── Legal Consent Records ─────────────────────────────────────────────────────
// CHARTWELL_PRELAUNCH_OPS_SPEC.md §2
//
// Records that a specific user or patient explicitly accepted a legal document.
// ownerType: "USER" | "PATIENT_ACCOUNT"
// documentType: "TERMS" | "PRIVACY"
// versionLabel: the "Last updated" date from the legal page at time of acceptance
// (e.g. "2026-09-30") — proves *what version* they accepted.

model ConsentRecord {
  id            String   @id @default(cuid())
  ownerType     String             // "USER" | "PATIENT_ACCOUNT"
  ownerId       String
  documentType  String             // "TERMS" | "PRIVACY"
  versionLabel  String             // legal page's "Last updated" date at time of acceptance
  acceptedAt    DateTime @default(now())
  ipAddress     String?

  @@index([ownerType, ownerId])
  @@index([documentType])
}

// ─── GST Tax Invoices ─────────────────────────────────────────────────────────
// CHARTWELL_PRELAUNCH_OPS_SPEC.md §3
//
// OpenORDO's own invoices to clinics for Plan subscriptions and Plugin purchases.
// INR invoices carry CGST+SGST (intra-state) or IGST (inter-state).
// USD invoices are plain receipts — Indian GST does not apply.
//
// invoiceNumber: sequential, financial-year-scoped (e.g. OO/2026-27/000123)
// billingType:   "PLAN_SUBSCRIPTION" | "PLUGIN_PURCHASE"
// currency:      "INR" | "USD"
// placeOfSupply: clinic's registered state — INR invoices only
// All amounts in smallest currency unit (paise for INR, cents for USD).

model TaxInvoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique          // sequential, financial-year-scoped
  clinicId      String
  billingType   String                    // "PLAN_SUBSCRIPTION" | "PLUGIN_PURCHASE"
  relatedId     String                    // the Subscription id or ClinicPlugin id
  currency      String                    // "INR" | "USD"
  issueDate     DateTime @default(now())
  
  countryCode   String            // which TaxCountryConfig applied at issue time
  taxLabel      String            // copied at issue time for immutability — "GST"/"VAT"/etc.
  taxAmount     Int      @default(0)

  taxableValue    Int                       // smallest currency unit
  platformFee     Int?                      // platform fee amount in smallest currency unit
  platformFeeRate String?                   // the percentage rate applied (e.g. "10")
  cgst            Int?                      // set only for intra-state INR invoices
  sgst          Int?                      // set only for intra-state INR invoices
  igst          Int?                      // set only for inter-state INR invoices
  totalValue    Int
  pdfFileKey    String?                   // private storage key — signed-URL delivery

  // Void tracking — numbers are never deleted, only voided
  isVoided      Boolean  @default(false)
  voidedAt      DateTime?
  voidReason    String?

  createdAt     DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@index([issueDate])
  @@index([currency])
}

// ─── Invoice Sequence Counter ─────────────────────────────────────────────────
// Atomic counter for GST invoice numbering — one row per financial year.
// financialYear: e.g. "2026-27"
// sequence:      current highest number in that year (incremented atomically)

model InvoiceSequence {
  id            String @id @default(cuid())
  financialYear String @unique  // e.g. "2026-27"
  sequence      Int    @default(0)
}

// ─── Internal Observability & Error Monitoring ────────────────────────────────

/// Internal logs for system errors, replacing Sentry.
/// NO PHI should ever be written to this table.
model SystemErrorLog {
  id           String   @id @default(cuid())
  level        String   @default("ERROR") // "ERROR", "WARN", "INFO"
  source       String   // "CLIENT", "SERVER", "EDGE"
  message      String
  stack        String?  // Stack trace, no PHI
  url          String?  // Request URL
  userId       String?  // UUID only, no names/emails
  clinicId     String?  // UUID only
  metadata     String?  // JSON string (Safe, sanitized data only)
  createdAt    DateTime @default(now())
}


model StoredFile {
  id            String    @id @default(cuid())
  scope         String
  clinicId      String?
  patientId     String?
  appointmentId String?
  category      String
  storageKey    String    @unique
  originalName  String
  mimeType      String
  sizeBytes     Int
  sha256        String
  width         Int?
  height        Int?
  variants      String?
  isPublicAsset Boolean   @default(false)
  uploadedById  String?
  uploadedByType String?
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  @@index([clinicId, patientId, category])
  @@index([clinicId, category, createdAt])
}

model SeoSitemapEntry {
  id         String   @id @default(cuid())
  path       String   @unique
  priority   Float    @default(0.5)
  changefreq String   @default("weekly")
  mode       String   @default("INCLUDE")
  updatedAt  DateTime @updatedAt
}
